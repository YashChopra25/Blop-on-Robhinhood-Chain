# Foundry build output
/cache/
/out/

# Broadcast logs: local Anvil runs and dry runs are throwaway. Testnet/mainnet
# broadcasts stay committed as the record of what was actually sent on-chain.
/broadcast/*/31337/
/broadcast/**/dry-run/

# Secrets: RPC URLs, deployer private keys, keystores
.env
.env.*
!.env.example
*.key
keystore/
out/

# Coverage and gas reports
lcov.info
/coverage/
/report/
.gas-snapshot.tmp

# Node (package.json / package-lock.json are committed)
/node_modules/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
