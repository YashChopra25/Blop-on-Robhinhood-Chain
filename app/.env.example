# =============================================================================
# Copy to .env.local and fill in. `cp .env.example .env.local`
# =============================================================================

# --- Chain -------------------------------------------------------------------
# REQUIRED. lib/evm/config.ts throws at import if unset, by design: a wrong
# chain id makes every read return empty and sends writes to the wrong network.
#   4663  = Robinhood Chain (mainnet)
#   46630 = Robinhood Chain Testnet
#   31337 = local Anvil
NEXT_PUBLIC_CHAIN_ID=31337

# Optional. Defaults to the chain's public endpoint. The Robinhood Chain docs
# state the public endpoints are rate-limited and not recommended for
# production, so set a dedicated provider URL for any real deployment.
# Must agree with NEXT_PUBLIC_CHAIN_ID or startup fails.
# NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Optional. Resolved from lib/evm/deployments.ts, which the deploy script and
# contracts/script/sync-abi.sh generate. Set only to override.
# NEXT_PUBLIC_CONTRACT_ADDRESS=0x…

# Optional. Injected wallets work without it; the WalletConnect connector is
# registered only when this is set.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Server-only secrets (never prefix these with NEXT_PUBLIC_) --------------

# REQUIRED for /api/auth/* — must be >= 32 chars or sessions are refused.
#   openssl rand -hex 32
SESSION_SECRET=

# REQUIRED for /api/ipfs/* (upload, retrieve, metadata, delete).
# JWT from https://app.pinata.cloud → API Keys. Without it the dashboard still
# browses, but document upload and preview fail.
PINATA_JWT_TOKEN=
PINATA_GATEWAY=
